{
  "name": "@mgomola/shelf-pdf-reader",
  "version": "0.3.0",
  "description": "Mobile-first React PDF reader (pdf.js) shared between Beskar Shelf and Vhetts Blueprints.",
  "license": "MIT",
  "author": "Martin Gomola",
  "homepage": "https://github.com/martin-gomola/shelf-pdf-reader#readme",
  "bugs": "https://github.com/martin-gomola/shelf-pdf-reader/issues",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/martin-gomola/shelf-pdf-reader.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b && node scripts/copy-css.mjs",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "prepare": "npm run build",
    "prepack": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "pdfjs-dist": "^4 || ^5",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.0.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~6.0.2",
    "vitest": "^4.1.4"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
